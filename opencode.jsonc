{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    },
    "dashboard-starter-kit": {
      "type": "local",
      "command": ["php", "artisan", "mcp:start", "dashboard-starter-kit"],
      "enabled": true
    }
  }
}
